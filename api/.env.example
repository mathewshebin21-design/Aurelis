# Copy to api/.env and fill in. Never commit real credentials.
AURELIS_DATABASE_URL=postgresql+psycopg://aurelis:aurelis-local-only@127.0.0.1:5432/aurelis
# Required by SEC fair-access policy: your name or organisation plus a contact email.
AURELIS_SEC_USER_AGENT="Your Name your.email@example.com"
AURELIS_SEC_MAX_REQUESTS_PER_SECOND=8
# Shared secret for /v1/admin/* until Phase 6 adds real authentication.
AURELIS_ADMIN_TOKEN=change-me
